#!/bin/sh
# A reminder, not a block: when a doc and its translation are out of sync, say so before the
# commit is made. CI fails on the push until they match; see CONTRIBUTING.md.

command -v node >/dev/null 2>&1 || exit 0
[ -f scripts/check-docs-sync.mjs ] || exit 0
out=$(node scripts/check-docs-sync.mjs --status 2>/dev/null) && exit 0
printf '%s\n%s\n%s\n' \
  "Note: these docs and their translations don't match yet:" "$out" \
  "Run /sync-docs in Claude Code before you push; CI fails until they match." >&2
exit 0
